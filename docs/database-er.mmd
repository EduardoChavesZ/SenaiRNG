  CARDS o|--o{ DUPLICATE_REWARD_CONFIGS : overrides
  USERS ||--o{ DUPLICATE_REWARD_CONFIGS : administers

  USERS {
    uuid id PK
    text email
    text role
    timestamptz deleted_at
  }
  USER_SESSIONS {
    uuid id PK
    uuid user_id FK
    text token_hash
    timestamptz expires_at
  }
  WALLETS {
    uuid user_id PK, FK
    bigint balance
    bigint gems_balance
    bigint xp_balance
  }
  WALLET_TRANSACTIONS {
    uuid id PK
    uuid user_id FK
    text type
    text currency
    bigint amount
  }
  SETTINGS {
    text key PK
    jsonb value
  }
  AUDIT_LOGS {
    uuid id PK
    uuid actor_user_id FK
    text entity_type
    jsonb before_data
    jsonb after_data
  }
  CATEGORIES {
    uuid id PK
    text name
    boolean active
  }
  RARITIES {
    uuid id PK
    text name
    bigint weight
    boolean active
  }
  CARDS {
    uuid id PK
    uuid category_id FK
    uuid rarity_id FK
    text image_path
    text image_mime_type
    integer image_width
    integer image_height
    boolean active
  }
  LEGACY_STOCK_MOVEMENTS {
    uuid id PK
    uuid card_id FK
    text type
    integer change_amount
    timestamptz created_at
  }
  DRAW_BATCHES {
    uuid id PK
    uuid user_id FK
    text idempotency_key
    smallint quantity
    text status
  }
  DRAWS {
    uuid id PK
    uuid batch_id FK
    uuid user_id FK
    uuid card_id FK
    uuid rarity_id FK
    smallint position
  }
  USER_CARDS {
    uuid user_id PK, FK
    uuid card_id PK, FK
    integer quantity
  }
  ACHIEVEMENTS {
    uuid id PK
    text key
    text requirement_type
  }
  USER_ACHIEVEMENTS {
    uuid user_id PK, FK
    uuid achievement_id PK, FK
    timestamptz unlocked_at
  }
  COSMETIC_ITEMS {
    uuid id PK
    text slug
    text kind
    bigint price_amount
  }
  USER_COSMETIC_ITEMS {
    uuid user_id PK, FK
    uuid item_id PK, FK
    uuid idempotency_key
  }
  USER_PROFILE_CUSTOMIZATIONS {
    uuid user_id PK, FK
    text nickname
    text theme
    uuid featured_card_id FK
  }
  USER_PREFERENCES {
    uuid user_id PK, FK
    boolean reduce_effects
    boolean invocation_music_enabled
    real sound_volume
  }
  DAILY_REWARDS {
    uuid id PK
    text currency
    bigint amount
    bigint weight
  }
  DAILY_STREAK_MILESTONES {
    integer consecutive_days PK
    text currency
    bigint amount
  }
  DAILY_STREAKS {
    uuid user_id PK, FK
    integer current_streak
    timestamptz last_claim_at
    timestamptz last_streak_at
  }
  DAILY_REWARD_HISTORY {
    uuid id PK
    uuid user_id FK
    uuid reward_id FK
    uuid transaction_id FK
    uuid idempotency_key
  }
  USER_GAME_STATS {
    uuid user_id PK, FK
    bigint total_draws
    integer unique_cards
  }
  INVOCATION_BANNERS {
    uuid id PK
    text slug
    text currency
    bigint unit_cost
    text image_path
    text image_mime_type
    integer image_width
    integer image_height
    text fallback_image_path
    smallint image_focal_x
    smallint image_focal_y
    integer version
  }
  INVOCATION_BANNER_CARDS {
    uuid banner_id PK, FK
    uuid card_id PK, FK
    bigint weight
  }
  INVOCATION_PITY_CONFIGS {
    uuid banner_id PK, FK
    uuid rarity_id FK
    smallint hard_pity_limit
  }
  USER_BANNER_PITY {
    uuid user_id PK, FK
    uuid banner_id PK, FK
    integer failures_count
  }
  DUPLICATE_REWARD_CONFIGS {
    uuid id PK
    uuid rarity_id FK
    uuid card_id FK
    bigint gold_amount
    bigint gems_amount
    bigint xp_amount
  }
