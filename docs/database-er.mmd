  USERS ||--o| USER_PREFERENCES : configures
  USERS ||--o| USER_GAME_STATS : tracks

  CATEGORIES o|--o{ CARDS : classifies
  RARITIES ||--o{ CARDS : assigns
  CARDS ||--o{ LEGACY_STOCK_MOVEMENTS : tracks

  USERS ||--o{ DRAW_BATCHES : requests
  DRAW_BATCHES ||--o{ DRAWS : contains
  USERS ||--o{ DRAWS : receives
  CARDS ||--o{ DRAWS : snapshots
  RARITIES ||--o{ DRAWS : snapshots
  USERS ||--o{ USER_CARDS : collects
  CARDS ||--o{ USER_CARDS : collected

  USERS ||--o{ USER_ACHIEVEMENTS : unlocks
  ACHIEVEMENTS ||--o{ USER_ACHIEVEMENTS : awarded
  USERS ||--o{ USER_COSMETIC_ITEMS : owns
  COSMETIC_ITEMS ||--o{ USER_COSMETIC_ITEMS : acquired
  COSMETIC_ITEMS o|--o{ USER_PROFILE_CUSTOMIZATIONS : equipped
  CARDS o|--o{ USER_PROFILE_CUSTOMIZATIONS : featured

  USERS ||--o| DAILY_STREAKS : tracks
  USERS ||--o{ DAILY_REWARD_HISTORY : claims
  DAILY_REWARDS o|--o{ DAILY_REWARD_HISTORY : grants
  WALLET_TRANSACTIONS ||--o{ DAILY_REWARD_HISTORY : credits
  WALLET_TRANSACTIONS o|--o{ DAILY_REWARD_HISTORY : streak_bonus

  USERS ||--o{ INVOCATION_BANNERS : creates
  INVOCATION_BANNERS ||--o{ INVOCATION_BANNER_CARDS : configures
  CARDS ||--o{ INVOCATION_BANNER_CARDS : included
  INVOCATION_BANNERS ||--o| INVOCATION_PITY_CONFIGS : guarantees
  RARITIES ||--o{ INVOCATION_PITY_CONFIGS : guaranteed_rarity
  USERS ||--o{ USER_BANNER_PITY : tracks
  INVOCATION_BANNERS ||--o{ USER_BANNER_PITY : tracks
